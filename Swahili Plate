    let cart = [];
    let activeCategory = { food:"All", drinks:"All" };
    let menuReady = { food:false, drinks:false };
    let sheetReady = false;

    const formatKES = amount => "KES " + Number(amount).toLocaleString("en-KE");
    const escapeHtml = value => String(value).replace(/[&<>"']/g, character => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#039;" }[character]));

    function showStatus(message, type = "info") {
      const toast = document.getElementById("status-toast");
      toast.style.background = type === "error" ? "#963c25" : type === "success" ? "#28654d" : "#123c4a";
      document.getElementById("status-message").textContent = message;
      toast.classList.add("show");
      clearTimeout(showStatus.timer);
      showStatus.timer = setTimeout(() => toast.classList.remove("show"), 4200);
    }

    function goTo(route) {
      document.querySelectorAll(".route").forEach(section => section.classList.toggle("active", section.id === route));
      document.querySelectorAll(".nav-link").forEach(link => link.classList.toggle("active", link.dataset.route === route));
      window.scrollTo({ top:0, behavior:"smooth" });
    }

    function closeMobileNav() {
      document.getElementById("mobile-nav").classList.remove("open");
      document.getElementById("mobile-menu-button").setAttribute("aria-expanded", "false");
    }

    function categoriesFor(type) {
      return ["All", ...new Set(MENU_DATA_CONFIG[type].map(item => item.category))];
    }

    function renderTabs(type) {
      const holder = document.getElementById(type + "-tabs");
      holder.innerHTML = categoriesFor(type).map(category => `
        <button type="button" data-category="${escapeHtml(category)}" class="menu-tab focus-ring whitespace-nowrap rounded-full border border-[#b8c8c5] px-4 py-2 text-sm font-bold ${activeCategory[type] === category ? "active" : ""}">
          ${escapeHtml(category)}
        </button>`).join("");
      holder.querySelectorAll("button").forEach(button => button.addEventListener("click", () => {
        activeCategory[type] = button.dataset.category;
        renderTabs(type);
        filterAndRenderMenu(type);
      }));
    }

    function itemPrice(item, variantIndex = 0) {
      if (item.variants && item.variants.length) return item.variants[variantIndex].price;
      return item.price;
    }

    function itemVariantName(item, variantIndex = 0) {
      if (item.variants && item.variants.length) return item.variants[variantIndex].name;
      return "";
    }

    function menuCard(item, index, type) {
      const cardId = type + "-" + index;
      const basePrice = itemPrice(item);
      const labels = (item.labels || []).map(label => `<span class="rounded-full bg-[#e3f0e9] px-3 py-1 text-xs font-bold text-[#28654d]">${escapeHtml(label)}</span>`).join("");
      const variants = item.variants && item.variants.length ? `
        <label class="mt-4 block text-sm font-bold text-[#31535c]" for="${cardId}-variant">Choose option</label>
        <select id="${cardId}-variant" class="variant-select focus-ring mt-1 w-full rounded-xl border border-[#c8d1cb] bg-white p-2.5 text-sm" data-card-id="${cardId}">
          ${item.variants.map((variant, variantIndex) => `<option value="${variantIndex}">${escapeHtml(variant.name)} — ${formatKES(variant.price)}</option>`).join("")}
        </select>` : "";
      const priceText = formatKES(basePrice);
      const cardBackground = type === "food" ? "bg-white" : "bg-[#f0e1ca]";
      return `
        <article id="${cardId}" class="menu-card ${cardBackground} rounded-3xl p-6 shadow-sm" data-type="${type}" data-index="${index}">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-bold uppercase tracking-[.14em] text-[#b95032]">${escapeHtml(item.category)}</p>
              <h2 class="display-font mt-1 text-2xl font-bold text-[#123c4a]">${escapeHtml(item.name)}</h2>
              <p class="mt-2 leading-6 text-[#49636b]">${escapeHtml(item.description)}</p>
            </div>
            <strong class="price-display shrink-0 text-right text-[#123c4a]">${priceText}</strong>
          </div>
          ${labels ? `<div class="mt-4 flex flex-wrap gap-2">${labels}</div>` : ""}
          ${variants}
          <div class="mt-5 flex items-center gap-3">
            <div class="flex items-center rounded-full border border-[#c8d1cb] bg-white">
              <button type="button" class="focus-ring quantity-change px-3 py-2 font-bold" data-change="-1" aria-label="Decrease ${escapeHtml(item.name)} quantity">−</button>
              <span class="card-quantity min-w-7 text-center font-bold" aria-live="polite">1</span>
              <button type="button" class="focus-ring quantity-change px-3 py-2 font-bold" data-change="1" aria-label="Increase ${escapeHtml(item.name)} quantity">+</button>
            </div>
            <button type="button" class="add-menu-item focus-ring flex-1 rounded-full ${type === "food" ? "bg-[#b95032] hover:bg-[#963c25]" : "bg-[#17677a] hover:bg-[#123c4a]"} px-4 py-3 font-bold text-white transition">
              Add to cart
            </button>
          </div>
        </article>`;
    }

    function filterAndRenderMenu(type) {
      const query = document.getElementById(type + "-search").value.trim().toLowerCase();
      const filtered = MENU_DATA_CONFIG[type].filter(item => {
        const searchable = [item.name, item.originalName, item.category, item.description, ...(item.labels || []), ...(item.variants || []).map(variant => variant.name)].join(" ").toLowerCase();
        return (activeCategory[type] === "All" || item.category === activeCategory[type]) && searchable.includes(query);
      });

      const grid = document.getElementById(type + "-grid");
      grid.innerHTML = filtered.map(item => menuCard(item, MENU_DATA_CONFIG[type].indexOf(item), type)).join("");
      document.getElementById(type + "-empty").classList.toggle("hidden", filtered.length > 0);
      bindMenuCardControls(grid);
      lucide.createIcons();
    }

    function bindMenuCardControls(grid) {
      grid.querySelectorAll(".quantity-change").forEach(button => button.addEventListener("click", () => {
        const quantity = button.closest(".menu-card").querySelector(".card-quantity");
        quantity.textContent = Math.max(1, Number(quantity.textContent) + Number(button.dataset.change));
      }));

      grid.querySelectorAll(".variant-select").forEach(select => select.addEventListener("change", () => {
        const card = select.closest(".menu-card");
        const item = MENU_DATA_CONFIG[card.dataset.type][Number(card.dataset.index)];
        const price = itemPrice(item, Number(select.value));
        const display = card.querySelector(".price-display");
        const addButton = card.querySelector(".add-menu-item");
        display.textContent = formatKES(price);
        addButton.disabled = false;
        addButton.textContent = "Add to cart";
      }));

      grid.querySelectorAll(".add-menu-item").forEach(button => button.addEventListener("click", () => {
        const card = button.closest(".menu-card");
        const item = MENU_DATA_CONFIG[card.dataset.type][Number(card.dataset.index)];
        const variantSelect = card.querySelector(".variant-select");
        const variantIndex = variantSelect ? Number(variantSelect.value) : 0;
        const price = itemPrice(item, variantIndex);
        const variant = itemVariantName(item, variantIndex);
        const name = variant ? item.name + " — " + variant : item.name;
        const quantity = Number(card.querySelector(".card-quantity").textContent);
        const existing = cart.find(cartItem => cartItem.name === name && cartItem.price === price);
        if (existing) existing.quantity += quantity;
        else cart.push({ name, price, quantity });
        renderCart();
        showStatus(name + " added to your cart.", "success");
      }));
    }

    function initialiseMenus() {
      ["food", "drinks"].forEach(type => {
        renderTabs(type);
        filterAndRenderMenu(type);
        document.getElementById(type + "-loading").classList.add("hidden");
        menuReady[type] = true;
        document.getElementById(type + "-search").addEventListener("input", () => filterAndRenderMenu(type));
      });
    }

    function serviceFee() {
      return document.getElementById("checkout-mode").value === "Take out" ? 100 : 0;
    }

    function renderCart() {
      const holder = document.getElementById("cart-items");
      const empty = document.getElementById("empty-cart");
      const clearButton = document.getElementById("clear-cart-button");
      empty.classList.toggle("hidden", cart.length > 0);
      clearButton.classList.toggle("hidden", cart.length === 0);

      holder.innerHTML = cart.map((item, index) => `
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-[#e9dfd2] py-5">
          <div><h3 class="display-font text-xl font-bold">${escapeHtml(item.name)}</h3><p class="mt-1 text-sm text-[#49636b]">${formatKES(item.price)} each</p></div>
          <div class="flex items-center gap-3">
            <div class="flex items-center rounded-full border border-[#c8d1cb]">
              <button type="button" class="focus-ring px-3 py-2 font-bold" onclick="changeCartQuantity(${index},-1)" aria-label="Decrease quantity">−</button>
              <span class="min-w-7 text-center font-bold">${item.quantity}</span>
              <button type="button" class="focus-ring px-3 py-2 font-bold" onclick="changeCartQuantity(${index},1)" aria-label="Increase quantity">+</button>
            </div>
            <strong class="min-w-24 text-right">${formatKES(item.price * item.quantity)}</strong>
            <button type="button" class="focus-ring rounded-full p-2 text-[#b95032]" onclick="removeCartItem(${index})" aria-label="Remove ${escapeHtml(item.name)}"><i data-lucide="trash-2" class="h-4 w-4"></i></button>
          </div>
        </div>`).join("");

      document.getElementById("cart-count").textContent = cart.reduce((total, item) => total + item.quantity, 0);
      updateTotals();
      lucide.createIcons();
    }

    function changeCartQuantity(index, amount) {
      cart[index].quantity += amount;
      if (cart[index].quantity <= 0) cart.splice(index, 1);
      renderCart();
    }

    function removeCartItem(index) {
      cart.splice(index, 1);
      renderCart();
    }

    function clearCart() {
      cart = [];
      renderCart();
      showStatus("Your cart has been cleared.");
    }

    function updateTotals() {
      const subtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
      const fee = serviceFee();
      document.getElementById("subtotal").textContent = formatKES(subtotal);
      document.getElementById("service-fee").textContent = formatKES(fee);
      document.getElementById("grand-total").textContent = formatKES(subtotal + fee);
    }

    function toggleCheckoutDineFields() {
      const dineIn = document.getElementById("checkout-mode").value === "Dine in";
      document.getElementById("checkout-dine-fields").classList.toggle("hidden", !dineIn);
      ["checkout-date", "checkout-time", "checkout-party"].forEach(id => document.getElementById(id).required = dineIn);
      updateTotals();
    }

    function updatePaymentInfo() {
      const branch = document.getElementById("checkout-branch").value;
      const target = document.getElementById("payment-info-text");
      if (branch === "CBD") target.textContent = "CBD payment instruction: use M-Pesa / payment contact 0711726448, or choose cash on collection / in person. Payment remains pending until confirmed by Swahili Plate.";
      else if (branch === "Sarit Centre") target.textContent = "Sarit Centre payment instruction: Till Number is awaiting update. Please choose cash on collection / in person, or contact 0773497954 for current payment guidance. Payment remains pending until confirmed.";
      else target.textContent = "Choose a branch to see the appropriate payment guidance. No payment is processed on this website.";
    }

    function setPending(control, pending) {
      control.disabled = pending;
      control.classList.toggle("opacity-60", pending);
      control.classList.toggle("cursor-wait", pending);
    }

    async function saveSubmission(record, control, successMessage) {
      if (!sheetReady) {
        showStatus("Ordering form connection is unavailable. Please contact a branch directly.", "error");
        return;
      }
      setPending(control, true);
      try {
        const result = await window.dataSdk.create(record);
        if (!result.isOk) showStatus("We could not confirm your submission. Please try again or contact the branch directly.", "error");
        else showStatus(successMessage, "success");
      } catch {
        showStatus("We could not submit this request. Please try again.", "error");
      } finally {
        setPending(control, false);
      }
    }

    async function initialiseSheet() {
      try {
        const initResult = await window.dataSdk.init({ onDataChanged() {} });
        if (!initResult.isOk) {
          showStatus("Ordering form connection is unavailable. Please contact a branch directly.", "error");
          return;
        }
        sheetReady = true;
      } catch {
        showStatus("Ordering form connection is unavailable. Please contact a branch directly.", "error");
      }
    }

    document.getElementById("checkout-mode").addEventListener("change", toggleCheckoutDineFields);
    document.getElementById("checkout-branch").addEventListener("change", updatePaymentInfo);

    document.getElementById("checkout-form").addEventListener("submit", async event => {
      event.preventDefault();
      if (!cart.length) return showStatus("Your cart is empty. Add something delicious before checkout.", "error");
      const mode = document.getElementById("checkout-mode").value;
      const subtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
      const fee = serviceFee();
      await saveSubmission({
        customer_name:document.getElementById("checkout-name").value.trim(),
        customer_phone:document.getElementById("checkout-phone").value.trim(),
        customer_email:document.getElementById("checkout-email").value.trim(),
        branch:document.getElementById("checkout-branch").value,
        ordering_mode:mode,
        cart_items:JSON.stringify(cart),
        subtotal,
        service_fee:fee,
        grand_total:subtotal + fee,
        reservation_date:mode === "Dine in" ? document.getElementById("checkout-date").value : "",
        reservation_time:mode === "Dine in" ? document.getElementById("checkout-time").value : "",
        party_size:mode === "Dine in" ? Number(document.getElementById("checkout-party").value) : 0,
        special_requests:document.getElementById("checkout-request").value.trim(),
        payment_method:document.getElementById("checkout-payment").value,
        payment_status:"Payment pending — order submitted",
        order_timestamp:new Date().toISOString()
      }, event.submitter, "Order submitted! Payment is pending. Swahili Plate will confirm your order details.");
    });

    document.getElementById("reservation-form").addEventListener("submit", async event => {
      event.preventDefault();
      await saveSubmission({
        customer_name:document.getElementById("reservation-name").value.trim(),
        customer_phone:document.getElementById("reservation-phone").value.trim(),
        customer_email:document.getElementById("reservation-email").value.trim(),
        branch:document.getElementById("reservation-branch").value,
        ordering_mode:"Dine in",
        cart_items:"Table reservation",
        subtotal:0,
        service_fee:0,
        grand_total:0,
        reservation_date:document.getElementById("reservation-date").value,
        reservation_time:document.getElementById("reservation-time").value,
        party_size:Number(document.getElementById("reservation-party").value),
        special_requests:document.getElementById("reservation-request").value.trim(),
        payment_method:"Pay in person",
        payment_status:"Reservation submitted — pending confirmation",
        order_timestamp:new Date().toISOString()
      }, event.submitter, "Reservation submitted! Swahili Plate will confirm your table.");
    });

    document.getElementById("mobile-menu-button").addEventListener("click", () => {
      const nav = document.getElementById("mobile-nav");
      nav.classList.toggle("open");
      document.getElementById("mobile-menu-button").setAttribute("aria-expanded", String(nav.classList.contains("open")));
    });

    document.addEventListener("DOMContentLoaded", () => {
      lucide.createIcons();
      initialiseMenus();
      renderCart();
      updatePaymentInfo();
      initialiseSheet();
    });
  </script>
 
</body></html>